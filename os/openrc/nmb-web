#!/sbin/openrc-run
description="NetworkMeasureBox Embedded Web UI & REST API"

command="/usr/bin/python3"
command_args="-m nmb.web.server"
command_background="yes"
command_user="nmb:nmb"
# Port 80 and network changes without root, like the systemd unit.
capabilities="^cap_net_bind_service,^cap_net_admin,^cap_net_raw"
pidfile="/run/nmb/web.pid"
output_log="/var/log/nmb/web.log"
error_log="/var/log/nmb/web.err"

depend() {
    need nmb-db
    after net
}

start_pre() {
    export PYTHONPATH=/opt/nmb
    checkpath -d -m 0750 -o nmb:nmb /run/nmb /var/log/nmb
}
