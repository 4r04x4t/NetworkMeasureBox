// Let the nmb service user manage its own services and reboot, without running as root.
polkit.addRule(function(action, subject) {
    if (subject.user != "nmb") {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id == "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit") || "";
        if (/^(nmb[-.]|wg-quick@|openvpn|tailscaled|hostapd|dnsmasq|NetworkManager)/.test(unit)) {
            return polkit.Result.YES;
        }
    }
    // Guest Wi-Fi (the box as a Wi-Fi client) runs nmcli as nmb.
    if (/^org\.freedesktop\.NetworkManager\.(network-control|wifi\.scan|enable-disable-wifi|settings\.modify\.system|settings\.modify\.own)$/.test(action.id)) {
        return polkit.Result.YES;
    }
    if (action.id == "org.freedesktop.login1.reboot" || action.id == "org.freedesktop.login1.reboot-multiple-sessions") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
