#!/bin/sh
# NetworkMeasureBox Hardened Sudo Privilege Isolation Helper
# Provides strictly parameterized, non-arbitrary root commands for nmb services.
set -eu

# wg-quick and OpenVPN run commands from these lines as root, and the files are written by the nmb user.
# Root work never runs in the caller's directory: Python would load modules from there (2026-11-10).
cd / || exit 1
unset PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONUSERBASE

# Allow-lists for the repair and driver actions (tests/test_helper_allowlists.py keeps them equal to
# nmb/common/heal.py and nmb/netd/drivers.py).
CORE_LINKS="nmb-netd nmb-probe nmb-speed nmb-report nmb-telegram nmb-web nmb-helper nmb-vpn nmb-wifi nmb-iperf nmb-ooni nmb-invasive-log nmb-factory-reset nmb-cli nmb-driver nmb-adblock pivpn pihole nmb-heal"
CORE_DIRS="/etc/nmb /var/lib/nmb /var/lib/nmb/live /var/lib/nmb/persist /var/lib/nmb/persist/reports /var/lib/nmb/adblock /var/lib/nmb/backups /var/log/nmb /run/nmb"
REPAIR_PACKAGES="dnsmasq ethtool hostapd iperf3 mtr-tiny ooniprobe-cli openvpn sqlite3 traceroute wireguard-tools"
DRIVER_PACKAGES="all firmware-realtek firmware-linux-nonfree firmware-misc-nonfree firmware-atheros firmware-iwlwifi firmware-brcm80211 ethtool pciutils usbutils kmod-usb-net-rtl8152 kmod-usb-net-asix kmod-usb-net-asix-ax88179 kmod-r8169 kmod-igc kmod-e1000e linux-firmware-realtek linux-firmware-other linux-firmware"
INSTALL_TARGETS="/usr/local/bin/rmbt-client /usr/local/bin/speedtest /usr/local/bin/ooniprobe"

in_list() {
    case " $2 " in *" $1 "*) return 0 ;; esac
    return 1
}

# A file root itself prepared: a regular file owned by root in a folder only root can change.
root_prepared_file() {
    [ -f "$1" ] && [ ! -L "$1" ] || return 1
    f="$(readlink -f "$1")" || return 1
    [ "$(stat -c %u "$f")" = 0 ] || return 1
    d="$(dirname "$f")"
    [ "$(stat -c %u "$d")" = 0 ] && [ $(( 0$(stat -c %a "$d") & 022 )) -eq 0 ] || return 1
    while [ "$d" != "/" ]; do
        d="$(dirname "$d")"
        mode="$(stat -c %a "$d")"
        [ "$(stat -c %u "$d")" = 0 ] || return 1
        # a folder others may write is fine only with the sticky bit (like /tmp): entries stay their owner's
        if [ $(( 0$mode & 022 )) -ne 0 ] && [ $(( 0$mode & 01000 )) -eq 0 ]; then return 1; fi
    done
    return 0
}

reject_unsafe_vpn_config() {
    if grep -Eiq '^[[:space:]]*(PreUp|PostUp|PreDown|PostDown)[[:space:]]*=' "$1" 2>/dev/null ||
       grep -Eiq '^[[:space:]]*(up|down|script-security|plugin|client-connect|client-disconnect|learn-address|auth-user-pass-verify|tls-verify|ipchange|route-up|route-pre-down|iproute|config|management|management-client-user|log|log-append|writepid|cd|chroot)([[:space:]]|$)' "$1" 2>/dev/null; then
        echo "Refusing VPN config with command lines or extra files: $1" >&2
        exit 1
    fi
    # The client allow-list is NMB's own folder only (see nmb/netd/openvpn.py CCD_DIR).
    if grep -Eiq '^[[:space:]]*client-config-dir[[:space:]]' "$1" 2>/dev/null &&
       grep -Ei '^[[:space:]]*client-config-dir[[:space:]]' "$1" | grep -Evq '^[[:space:]]*client-config-dir[[:space:]]+/etc/openvpn/nmb-ccd[[:space:]]*$'; then
        echo "Refusing VPN config with a foreign client-config-dir: $1" >&2
        exit 1
    fi
}

# Root code runs from / with an isolated interpreter and only the root-owned install on its path.
nmb_root_python() {
    ( cd / && /usr/bin/python3 -I -c "import sys; sys.path.insert(0, '/opt/nmb'); $1" )
}

# Rebuild /etc/openvpn/nmb-ccd from the recorded clients; make sure the server config enforces it.
openvpn_ccd_sync() {
    install -d -m 0755 -o root -g root /etc/openvpn/nmb-ccd
    nmb_root_python "from nmb.netd.openvpn import write_ccd_allowlist; write_ccd_allowlist()" || return 1
    chown -R root:root /etc/openvpn/nmb-ccd
    for f in /etc/openvpn/server.conf /etc/openvpn/server/server.conf; do
        [ -f "$f" ] && append_ccd_directives "$f"
    done
}

# Add the allow-list lines to an older server config; a file without a final newline gets one first
# (2026-11-10: the first line was glued to "verb 3" and OpenVPN refused to start).
append_ccd_directives() {
    [ -s "$1" ] && [ -n "$(tail -c 1 "$1")" ] && printf '\n' >> "$1"
    grep -Eq '^[[:space:]]*client-config-dir[[:space:]]' "$1" || printf 'client-config-dir /etc/openvpn/nmb-ccd\n' >> "$1"
    grep -Eq '^[[:space:]]*ccd-exclusive([[:space:]]|$)' "$1" || printf 'ccd-exclusive\n' >> "$1"
    return 0
}

case "${1:-}" in
    upgrade)
        # Run outside nmb's own service sandbox when systemd is there.
        RUN=""
        command -v systemd-run >/dev/null 2>&1 && RUN="systemd-run --pipe --wait --quiet"
        if command -v apt-get >/dev/null 2>&1; then
            exec $RUN /bin/sh -c 'export DEBIAN_FRONTEND=noninteractive; apt-get update && apt-get -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" upgrade'
        elif command -v dnf >/dev/null 2>&1; then
            exec $RUN dnf -y upgrade --refresh
        elif command -v apk >/dev/null 2>&1; then
            exec $RUN /bin/sh -c 'apk update && apk upgrade'
        fi
        echo "No supported package manager found." >&2
        exit 1
        ;;
    check-updates)
        # Prints one "Inst <package>" line per available update, whatever the package manager.
        RUN=""
        command -v systemd-run >/dev/null 2>&1 && RUN="systemd-run --pipe --wait --quiet"
        if command -v apt-get >/dev/null 2>&1; then
            exec $RUN /bin/sh -c "apt-get update >/dev/null && apt-get -s upgrade"
        elif command -v dnf >/dev/null 2>&1; then
            $RUN dnf -q check-update --refresh | awk 'NF==3 && $1 ~ /\./ {print "Inst " $1}'
            exit 0
        elif command -v apk >/dev/null 2>&1; then
            $RUN /bin/sh -c 'apk update >/dev/null && apk version -l "<"' | awk 'NR>1 {print "Inst " $1}'
            exit 0
        fi
        echo "No supported package manager found." >&2
        exit 1
        ;;
    tune)
        if [ -x /opt/nmb/os/nic-tune.sh ]; then
            exec /opt/nmb/os/nic-tune.sh
        elif [ -x "$(dirname "$0")/../os/nic-tune.sh" ]; then
            exec "$(dirname "$0")/../os/nic-tune.sh"
        fi
        ;;
    wireguard-apply)
        mkdir -p /etc/wireguard
        if [ ! -f /var/lib/nmb/wireguard/wg0.conf ]; then
            python3 -c "import sys; sys.path.insert(0, '/opt/nmb'); from nmb.netd.wireguard import generate_server_config, WG_CONF, _ensure_dir; _ensure_dir(); WG_CONF.write_text(generate_server_config())" 2>/dev/null || true
        fi
        if [ -f /var/lib/nmb/wireguard/wg0.conf ]; then
            reject_unsafe_vpn_config /var/lib/nmb/wireguard/wg0.conf
            cp /var/lib/nmb/wireguard/wg0.conf /etc/wireguard/wg0.conf
            chmod 600 /etc/wireguard/wg0.conf
            chown root:root /etc/wireguard/wg0.conf
        fi
        sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
        sysctl -w net.ipv6.conf.all.forwarding=1 >/dev/null 2>&1 || true
        sysctl -w net.ipv6.conf.default.forwarding=1 >/dev/null 2>&1 || true
        systemctl restart wg-quick@wg0
        ;;
    wireguard-start)
        mkdir -p /etc/wireguard
        if [ ! -f /var/lib/nmb/wireguard/wg0.conf ]; then
            python3 -c "import sys; sys.path.insert(0, '/opt/nmb'); from nmb.netd.wireguard import generate_server_config, WG_CONF, _ensure_dir; _ensure_dir(); WG_CONF.write_text(generate_server_config())" 2>/dev/null || true
        fi
        if [ -f /var/lib/nmb/wireguard/wg0.conf ]; then
            reject_unsafe_vpn_config /var/lib/nmb/wireguard/wg0.conf
            cp /var/lib/nmb/wireguard/wg0.conf /etc/wireguard/wg0.conf
            chmod 600 /etc/wireguard/wg0.conf
            chown root:root /etc/wireguard/wg0.conf
        fi
        sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
        sysctl -w net.ipv6.conf.all.forwarding=1 >/dev/null 2>&1 || true
        sysctl -w net.ipv6.conf.default.forwarding=1 >/dev/null 2>&1 || true
        systemctl restart wg-quick@wg0 2>/dev/null || exec systemctl start wg-quick@wg0
        ;;
    wireguard-stop)
        exec systemctl stop wg-quick@wg0
        ;;
    wireguard-status)
        exec wg show
        ;;
    openvpn-apply)
        mkdir -p /etc/openvpn/server /etc/openvpn
        if [ ! -f /var/lib/nmb/openvpn/server.conf ]; then
            python3 -c "import sys; sys.path.insert(0, '/opt/nmb'); from nmb.netd.openvpn import init_pki, generate_server_config, OV_CONF, _ensure_dir; _ensure_dir(); init_pki(); OV_CONF.write_text(generate_server_config())" 2>/dev/null || true
        fi
        if [ -f /var/lib/nmb/openvpn/server.conf ]; then
            reject_unsafe_vpn_config /var/lib/nmb/openvpn/server.conf
            cp /var/lib/nmb/openvpn/server.conf /etc/openvpn/server.conf
            cp /var/lib/nmb/openvpn/server.conf /etc/openvpn/server/server.conf 2>/dev/null || true
            chmod 600 /etc/openvpn/server.conf /etc/openvpn/server/server.conf 2>/dev/null || true
        fi
        chown -R nmb:nmb /var/lib/nmb/openvpn /var/lib/nmb/wireguard 2>/dev/null || true
        chmod 644 /var/lib/nmb/openvpn/ipp.txt 2>/dev/null || true
        openvpn_ccd_sync || { echo "OpenVPN client allow-list not written; server not started" >&2; exit 1; }
        sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
        sysctl -w net.ipv6.conf.all.forwarding=1 >/dev/null 2>&1 || true
        sysctl -w net.ipv6.conf.default.forwarding=1 >/dev/null 2>&1 || true
        systemctl stop openvpn@server 2>/dev/null || true
        systemctl restart openvpn-server@server 2>/dev/null || systemctl restart openvpn@server
        ;;
    openvpn-ccd-sync)
        # A new client may connect; the running server keeps its other sessions (ccd is read per connection).
        openvpn_ccd_sync
        ;;
    openvpn-ccd-revoke)
        # A deleted client: off the allow-list, and its running session ends with the restart.
        openvpn_ccd_sync || exit 1
        if systemctl is-active --quiet openvpn-server@server 2>/dev/null; then
            systemctl restart openvpn-server@server
        elif systemctl is-active --quiet openvpn@server 2>/dev/null; then
            systemctl restart openvpn@server
        fi
        ;;
    openvpn-start)
        mkdir -p /etc/openvpn/server /etc/openvpn
        if [ ! -f /var/lib/nmb/openvpn/server.conf ]; then
            python3 -c "import sys; sys.path.insert(0, '/opt/nmb'); from nmb.netd.openvpn import init_pki, generate_server_config, OV_CONF, _ensure_dir; _ensure_dir(); init_pki(); OV_CONF.write_text(generate_server_config())" 2>/dev/null || true
        fi
        if [ -f /var/lib/nmb/openvpn/server.conf ]; then
            reject_unsafe_vpn_config /var/lib/nmb/openvpn/server.conf
            cp /var/lib/nmb/openvpn/server.conf /etc/openvpn/server.conf
            cp /var/lib/nmb/openvpn/server.conf /etc/openvpn/server/server.conf 2>/dev/null || true
            chmod 600 /etc/openvpn/server.conf /etc/openvpn/server/server.conf 2>/dev/null || true
        fi
        chown -R nmb:nmb /var/lib/nmb/openvpn /var/lib/nmb/wireguard 2>/dev/null || true
        chmod 644 /var/lib/nmb/openvpn/ipp.txt 2>/dev/null || true
        openvpn_ccd_sync || { echo "OpenVPN client allow-list not written; server not started" >&2; exit 1; }
        sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
        sysctl -w net.ipv6.conf.all.forwarding=1 >/dev/null 2>&1 || true
        sysctl -w net.ipv6.conf.default.forwarding=1 >/dev/null 2>&1 || true
        systemctl stop openvpn@server 2>/dev/null || true
        systemctl restart openvpn-server@server 2>/dev/null || exec systemctl start openvpn@server
        ;;
    openvpn-stop)
        systemctl stop openvpn-server@server 2>/dev/null || true
        systemctl stop openvpn@server 2>/dev/null || true
        ;;
    openvpn-status)
        systemctl is-active openvpn-server@server 2>/dev/null || exec systemctl is-active openvpn@server
        ;;
    vpn-nat)
        sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
        sysctl -w net.ipv6.conf.all.forwarding=1 >/dev/null 2>&1 || true
        sysctl -w net.ipv6.conf.default.forwarding=1 >/dev/null 2>&1 || true

        # Find default route WAN interface for IPv4 and IPv6
        WAN_IFACE=$(ip route show default 2>/dev/null | awk '{print $5}' | head -n 1)
        WAN6_IFACE=$(ip -6 route show default 2>/dev/null | awk '{print $5}' | head -n 1)
        [ -z "$WAN6_IFACE" ] && WAN6_IFACE="$WAN_IFACE"

        if [ -n "$WAN_IFACE" ]; then
            iptables -C FORWARD -i wg0 -j ACCEPT 2>/dev/null || iptables -A FORWARD -i wg0 -j ACCEPT
            iptables -C FORWARD -o wg0 -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || iptables -A FORWARD -o wg0 -m state --state RELATED,ESTABLISHED -j ACCEPT
            iptables -t nat -C POSTROUTING -s 10.8.0.0/24 -o "$WAN_IFACE" -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s 10.8.0.0/24 -o "$WAN_IFACE" -j MASQUERADE

            iptables -C FORWARD -i tun0 -j ACCEPT 2>/dev/null || iptables -A FORWARD -i tun0 -j ACCEPT
            iptables -C FORWARD -o tun0 -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || iptables -A FORWARD -o tun0 -m state --state RELATED,ESTABLISHED -j ACCEPT
            iptables -t nat -C POSTROUTING -s 10.9.0.0/24 -o "$WAN_IFACE" -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s 10.9.0.0/24 -o "$WAN_IFACE" -j MASQUERADE
        fi

        # IPv6 Dual-Stack VPN Forwarding & NAT66 Masquerading
        if command -v ip6tables >/dev/null 2>&1; then
            ip6tables -C FORWARD -i wg0 -j ACCEPT 2>/dev/null || ip6tables -A FORWARD -i wg0 -j ACCEPT
            ip6tables -C FORWARD -o wg0 -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || ip6tables -A FORWARD -o wg0 -m state --state RELATED,ESTABLISHED -j ACCEPT
            if [ -n "$WAN6_IFACE" ]; then
                ip6tables -t nat -C POSTROUTING -s fd42:42:42::/64 -o "$WAN6_IFACE" -j MASQUERADE 2>/dev/null || ip6tables -t nat -A POSTROUTING -s fd42:42:42::/64 -o "$WAN6_IFACE" -j MASQUERADE 2>/dev/null || true
            else
                ip6tables -t nat -C POSTROUTING -s fd42:42:42::/64 -j MASQUERADE 2>/dev/null || ip6tables -t nat -A POSTROUTING -s fd42:42:42::/64 -j MASQUERADE 2>/dev/null || true
            fi

            ip6tables -C FORWARD -i tun0 -j ACCEPT 2>/dev/null || ip6tables -A FORWARD -i tun0 -j ACCEPT
            ip6tables -C FORWARD -o tun0 -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || ip6tables -A FORWARD -o tun0 -m state --state RELATED,ESTABLISHED -j ACCEPT
            if [ -n "$WAN6_IFACE" ]; then
                ip6tables -t nat -C POSTROUTING -s fd42:42:43::/64 -o "$WAN6_IFACE" -j MASQUERADE 2>/dev/null || ip6tables -t nat -A POSTROUTING -s fd42:42:43::/64 -o "$WAN6_IFACE" -j MASQUERADE 2>/dev/null || true
            else
                ip6tables -t nat -C POSTROUTING -s fd42:42:43::/64 -j MASQUERADE 2>/dev/null || ip6tables -t nat -A POSTROUTING -s fd42:42:43::/64 -j MASQUERADE 2>/dev/null || true
            fi
        fi
        ;;
    wifi-reg-set)
        CC="${2:-00}"
        IW_BIN=""
        if [ -x /usr/sbin/iw ]; then
            IW_BIN="/usr/sbin/iw"
        elif command -v iw >/dev/null 2>&1; then
            IW_BIN="$(command -v iw)"
        fi
        if [ -n "$IW_BIN" ]; then
            if echo "$CC" | grep -Eq '^[A-Za-z0-9]{2}$'; then
                exec "$IW_BIN" reg set "$CC"
            fi
        fi
        ;;
    logs-purge)
        # 1. Safely rotate and vacuum system journal
        if command -v journalctl >/dev/null 2>&1; then
            journalctl --rotate >/dev/null 2>&1 || true
            journalctl --vacuum-time=1s >/dev/null 2>&1 || true
        fi
        # 2. Truncate standard syslog files if they exist
        for f in /var/log/syslog /var/log/messages /var/log/kern.log /var/log/daemon.log; do
            if [ -f "$f" ]; then
                : > "$f" 2>/dev/null || true
            fi
        done
        # 3. Truncate kernel ring buffer
        if command -v dmesg >/dev/null 2>&1; then
            dmesg -c >/dev/null 2>&1 || true
        fi
        ;;
    install-drivers)
        # Parameterized installation of network driver and firmware packages
        PKG="${2:-all}"
        # Only the driver and firmware packages NMB recommends (nmb/netd/drivers.py), never any package.
        if ! in_list "$PKG" "$DRIVER_PACKAGES"; then
            echo "Refusing: '$PKG' is not one of the driver or firmware packages NMB installs." >&2
            exit 1
        fi
        if command -v apt-get >/dev/null 2>&1; then
            export DEBIAN_FRONTEND=noninteractive
            # Enable non-free and non-free-firmware components across deb822 sources and classic sources.list
            for src in /etc/apt/sources.list.d/*.sources; do
                if [ -f "$src" ] && grep -qi "Components:" "$src" && ! grep -qi "non-free-firmware" "$src"; then
                    sed -i '/Components:/ s/$/ contrib non-free non-free-firmware/' "$src" 2>/dev/null || true
                fi
            done
            if [ -s /etc/apt/sources.list ] && ! grep -qi "non-free" /etc/apt/sources.list 2>/dev/null; then
                sed -i 's/main$/main contrib non-free non-free-firmware/' /etc/apt/sources.list 2>/dev/null || true
            fi
            apt-get update -y
            if [ "$PKG" = "all" ]; then
                apt-get install -y --no-install-recommends \
                    firmware-realtek firmware-linux-nonfree firmware-misc-nonfree \
                    firmware-atheros firmware-iwlwifi firmware-brcm80211 \
                    ethtool pciutils usbutils 2>&1
            else
                apt-get install -y --no-install-recommends "$PKG" 2>&1
            fi
        elif command -v opkg >/dev/null 2>&1; then
            opkg update
            if [ "$PKG" = "all" ]; then
                opkg install kmod-usb-net-rtl8152 kmod-usb-net-asix kmod-usb-net-asix-ax88179 kmod-r8169 kmod-e1000e 2>&1
            else
                opkg install "$PKG" 2>&1
            fi
        elif command -v apk >/dev/null 2>&1; then
            apk update
            if [ "$PKG" = "all" ]; then
                apk add --no-cache linux-firmware-realtek linux-firmware-other ethtool pciutils usbutils 2>&1
            else
                apk add --no-cache "$PKG" 2>&1
            fi
        elif command -v pacman >/dev/null 2>&1; then
            pacman -Sy --noconfirm linux-firmware ethtool pciutils usbutils 2>&1
        elif command -v dnf >/dev/null 2>&1; then
            dnf install -y linux-firmware ethtool pciutils usbutils 2>&1
        else
            echo "No supported package manager found for driver installation." >&2
            exit 1
        fi
        command -v udevadm >/dev/null 2>&1 && udevadm trigger 2>/dev/null || true
        ;;
    backup-create)
        shift
        PYTHONPATH=/opt/nmb exec /usr/bin/python3 -m nmb.common.backup create "$@"
        ;;
    backup-restore)
        shift
        PYTHONPATH=/opt/nmb exec /usr/bin/python3 -m nmb.common.backup restore "$@"
        ;;
    backup-list)
        shift
        PYTHONPATH=/opt/nmb exec /usr/bin/python3 -m nmb.common.backup list "$@"
        ;;
    backup-delete)
        shift
        PYTHONPATH=/opt/nmb exec /usr/bin/python3 -m nmb.common.backup delete "$@"
        ;;
    factory-reset)
        shift
        if [ -x "$(dirname "$0")/nmb-factory-reset" ]; then
            exec "$(dirname "$0")/nmb-factory-reset" "$@"
        elif [ -x /opt/nmb/bin/nmb-factory-reset ]; then
            exec /opt/nmb/bin/nmb-factory-reset "$@"
        fi
        ;;
    usb-import)
        shift
        PYTHONPATH=/opt/nmb exec /usr/bin/python3 -m nmb.common.usb_import "$@"
        ;;
    sync-drive-config)
        PYTHONPATH=/opt/nmb exec /usr/bin/python3 -c "from nmb.config import sync_drive_config; sync_drive_config()"
        ;;
    invasive-log)
        shift
        if [ -x "$(dirname "$0")/nmb-invasive-log" ]; then
            exec "$(dirname "$0")/nmb-invasive-log" "$@"
        elif [ -x /opt/nmb/bin/nmb-invasive-log ]; then
            exec /opt/nmb/bin/nmb-invasive-log "$@"
        else
            PYTHONPATH=/opt/nmb exec /usr/bin/python3 -c "from nmb.report.invasive_logger import generate_invasive_snapshot; md, _ = generate_invasive_snapshot(force_write=True); print(md)"
        fi
        ;;
    diagnostic-bundle)
        PYTHONPATH=/opt/nmb exec /usr/bin/python3 -c "from nmb.report.crash_trap import create_diagnostic_bundle; p = create_diagnostic_bundle(); print(p)"
        ;;
    crashes-list)
        PYTHONPATH=/opt/nmb exec /usr/bin/python3 -c "import json; from nmb.report.crash_trap import list_crash_reports; print(json.dumps(list_crash_reports(), indent=2))"
        ;;
    crashes-clear)
        PYTHONPATH=/opt/nmb exec /usr/bin/python3 -c "from nmb.report.crash_trap import clear_crash_reports; n = clear_crash_reports(); print(f'Cleared {n} crash report(s).')"
        ;;
    heal-symlink)
        LINK_NAME="${2:-}"
        TARGET_PATH="${3:-}"
        case "$LINK_NAME" in
            pivpn) EXPECT=/opt/nmb/bin/nmb-vpn ;;
            pihole) EXPECT=/opt/nmb/bin/nmb-adblock ;;
            *) EXPECT="/opt/nmb/bin/$LINK_NAME" ;;
        esac
        if ! in_list "$LINK_NAME" "$CORE_LINKS" || [ "$TARGET_PATH" != "$EXPECT" ] || [ ! -f "$EXPECT" ]; then
            echo "Refusing symlink: only NMB's own commands to /opt/nmb/bin." >&2
            exit 1
        fi
        ln -sfn "$EXPECT" "/usr/local/bin/$LINK_NAME"
        ;;
    heal-permissions)
        DIR_PATH="${2:-}"
        if ! in_list "$DIR_PATH" "$CORE_DIRS"; then
            echo "Refusing: not one of NMB's own folders." >&2
            exit 1
        fi
        [ -L "$DIR_PATH" ] && { echo "Refusing: $DIR_PATH is a symlink." >&2; exit 1; }
        mkdir -p "$DIR_PATH"
        chown nmb:nmb "$DIR_PATH" 2>/dev/null || true
        chmod 2775 "$DIR_PATH" 2>/dev/null || true
        ;;
    heal-restore-config)
        MIRROR_PATH="${2:-}"
        case "$MIRROR_PATH" in
            /boot/firmware/nmb.conf|/boot/nmb.conf) ;;
            *) echo "Refusing: only the boot-partition copy can restore the settings." >&2; exit 1 ;;
        esac
        nmb_root_python "from pathlib import Path; from nmb.config import install_drive_config; sys.exit(0 if install_drive_config(Path('$MIRROR_PATH')) else 1)"
        ;;
    heal-install-file)
        SRC_PATH="${2:-}"
        DST_PATH="${3:-}"
        if ! in_list "$DST_PATH" "$INSTALL_TARGETS"; then
            echo "Refusing: not one of NMB's engine programs." >&2
            exit 1
        fi
        if ! root_prepared_file "$SRC_PATH"; then
            echo "Refusing: the program must be prepared by root (owned by root, in a folder only root can change)." >&2
            exit 1
        fi
        install -m 755 -o root -g root "$SRC_PATH" "$DST_PATH"
        ;;
    heal-dpkg-repair)
        # Kill stale apt processes holding locks if unresponsive
        killall -9 apt-get dpkg 2>/dev/null || true
        rm -f /var/lib/apt/lists/lock /var/cache/apt/archives/lock /var/lib/dpkg/lock* 2>/dev/null || true
        dpkg --configure -a 2>&1 || true
        DEBIAN_FRONTEND=noninteractive apt-get install -f -y 2>&1 || true
        DEBIAN_FRONTEND=noninteractive apt-get update -y 2>&1 || true
        ;;
    heal-pkg-install)
        PKG="${2:-}"
        if ! in_list "$PKG" "$REPAIR_PACKAGES"; then
            echo "Refusing: '$PKG' is not one of the packages NMB repairs." >&2
            exit 1
        fi
        if [ -n "$PKG" ]; then
            if command -v apt-get >/dev/null 2>&1; then
                export DEBIAN_FRONTEND=noninteractive
                apt-get update -y 2>/dev/null || true
                exec apt-get install -y --reinstall --no-install-recommends "$PKG"
            elif command -v apk >/dev/null 2>&1; then
                exec apk add --no-cache "$PKG"
            elif command -v pacman >/dev/null 2>&1; then
                exec pacman -S --noconfirm "$PKG"
            fi
        fi
        ;;
    heal-audit)
        PYTHONPATH=/opt/nmb exec /usr/bin/python3 -c "import json; from nmb.common.heal import audit_system_health; print(json.dumps(audit_system_health(), indent=2))"
        ;;
    heal-fix)
        shift
        PYTHONPATH=/opt/nmb exec /usr/bin/python3 -m nmb.common.heal fix "$@"
        ;;
    self-update)
        # self-update {check|status|start [commit]|run [commit]}
        # start: in the background (the web server); run: in the foreground (the CLI).
        # setup.sh replaces /opt/nmb, so the updater runs from its own copy of the code.
        mode="${2:-check}"
        commit="${3:-}"
        case "$commit" in
            "") ;;
            *[!0-9a-f]*) echo "Invalid commit" >&2; exit 1 ;;
            *) [ "${#commit}" -eq 40 ] || { echo "Invalid commit" >&2; exit 1; } ;;
        esac
        case "$mode" in
            check|status)
                PYTHONPATH=/opt/nmb exec python3 -m nmb.common.updater "$mode"
                ;;
            start|run)
                if [ -f /var/lib/nmb/update_status.json ] && grep -q '"state": "running"' /var/lib/nmb/update_status.json \
                   && [ $(( $(date +%s) - $(stat -c %Y /var/lib/nmb/update_status.json) )) -lt 3600 ]; then
                    echo "An update is already running" >&2
                    exit 1
                fi
                runner=/var/lib/nmb/update-runner
                rm -rf "$runner"
                install -d -m 0700 "$runner"
                cp -r /opt/nmb/nmb "$runner/"
                if [ "$mode" = "run" ]; then
                    PYTHONPATH="$runner" exec python3 -m nmb.common.updater apply $commit
                fi
                if [ -d /run/systemd/system ]; then
                    systemctl reset-failed nmb-self-update.service >/dev/null 2>&1 || true
                    systemd-run --unit=nmb-self-update --collect --quiet \
                        --setenv=PYTHONPATH="$runner" python3 -m nmb.common.updater apply $commit
                else
                    PYTHONPATH="$runner" setsid nohup python3 -m nmb.common.updater apply $commit \
                        >/dev/null 2>&1 </dev/null &
                fi
                echo '{"state": "started"}'
                ;;
            *) echo "Usage: nmb-helper self-update {check|status|start [commit]|run [commit]}" >&2; exit 1 ;;
        esac
        ;;
    *)
        echo "Usage: nmb-helper {upgrade|check-updates|tune|wireguard-apply|wireguard-start|wireguard-stop|wireguard-status|openvpn-apply|openvpn-ccd-sync|openvpn-ccd-revoke|openvpn-start|openvpn-stop|openvpn-status|vpn-nat|logs-purge|wifi-reg-set <CC>|install-drivers [PKG]|backup-create|backup-restore <path>|backup-list|backup-delete <file>|factory-reset|sync-drive-config|usb-import <dev>|invasive-log|diagnostic-bundle|crashes-list|crashes-clear|heal-symlink|heal-permissions|heal-restore-config|heal-install-file|heal-dpkg-repair|heal-pkg-install|heal-audit|heal-fix|self-update}" >&2
        exit 1
        ;;
esac
