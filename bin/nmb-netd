#!/usr/bin/env python3
import sys
from pathlib import Path

# Add project root and /opt/nmb to sys.path
root = Path(__file__).resolve().parent.parent
if str(root) not in sys.path:
    sys.path.insert(0, str(root))
if "/opt/nmb" not in sys.path:
    sys.path.append("/opt/nmb")

from nmb.netd.daemon import main

if __name__ == "__main__":
    sys.exit(main())
