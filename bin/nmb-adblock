#!/usr/bin/env python3
"""NetworkMeasureBox DNS Ad-Blocker & Sinkhole Management CLI (nmb-adblock / pihole).

Provides full command-line management for the built-in OS-independent Pi-hole equivalent
DNS ad-blocker, gravity updater, whitelist/blacklist manager, adlists manager,
local DNS resolver, regex filters, and live query monitor.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import time
from pathlib import Path

# Add project root to sys.path
SCRIPT_DIR = Path(__file__).resolve().parent
REPO_ROOT = SCRIPT_DIR.parent
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from nmb.netd.adblock import (
    get_full_adblock_status,
    set_adblock_enabled,
    disable_adblock_temporarily,
    enable_adblock,
    execute_gravity_update,
    trigger_gravity_update,
    get_adblock_engine,
    get_whitelist_entries,
    add_whitelist_entry,
    remove_whitelist_entry,
    get_blacklist_entries,
    add_blacklist_entry,
    remove_blacklist_entry,
    get_adlists,
    add_adlist,
    remove_adlist,
    toggle_adlist,
    get_local_dns_records,
    add_local_dns_record,
    remove_local_dns_record,
    get_regex_filters,
    add_regex_filter,
    remove_regex_filter,
    get_charts_telemetry,
    get_router_dhcp_guide,
    is_adblock_running,
)


def _color(text: str, code: str) -> str:
    if not sys.stdout.isatty():
        return text
    return f"\033[{code}m{text}\033[0m"


def cmd_status(args: argparse.Namespace) -> int:
    status = get_full_adblock_status()
    if args.json:
        print(json.dumps(status, indent=2))
        return 0

    print(_color("=" * 76, "1;34"))
    print(_color("  NetworkMeasureBox — DNS Ad-Blocker & Sinkhole Status (Pi-hole Engine)", "1;32"))
    print(_color("=" * 76, "1;34"))

    enabled = status.get("enabled", False)
    running = status.get("is_running", False)
    disabled_until = status.get("disabled_until")
    seconds_left = status.get("disabled_seconds_left", 0)

    if not enabled:
        if seconds_left > 0:
            badge = _color(f"PAUSED (Expires in {seconds_left}s)", "1;33")
        else:
            badge = _color("DISABLED", "1;31")
    else:
        badge = _color("ENABLED (ACTIVE)", "1;32")

    service_badge = _color("RUNNING (Port 53)", "1;32") if running else _color("STOPPED", "1;33")

    domains = status.get("domains_in_blocklist", 0)
    total_q = status.get("total_queries", 0)
    blocked_q = status.get("blocked_queries", 0)
    cached_q = status.get("cached_queries", 0)
    pct = status.get("blocked_percentage", 0.0)
    wl_count = status.get("whitelist_count", 0)
    bl_count = status.get("blacklist_count", 0)
    rgx_count = status.get("regex_blacklist_count", 0) + status.get("regex_whitelist_count", 0)
    ldns_count = status.get("custom_dns_count", 0)
    adlists_count = status.get("adlists_count", 0)
    last_up = status.get("last_gravity_update_iso") or "Never"
    upstreams = ", ".join(status.get("upstreams", []))

    print(f"  * Status            : {badge} [Service: {service_badge}]")
    print(f"  * Blocklist Gravity : {_color(f'{domains:,}', '1;36')} domains active across {adlists_count} adlists")
    print(f"  * Total Queries     : {_color(f'{total_q:,}', '1;37')} (Today)")
    print(f"  * Blocked Queries   : {_color(f'{blocked_q:,}', '1;31')} ({_color(f'{pct}%', '1;33')})")
    print(f"  * Cached Queries    : {cached_q:,}")
    print(f"  * Whitelist/Blacklist: {wl_count} allowed | {bl_count} custom blocked | {rgx_count} regex")
    print(f"  * Local DNS Records : {ldns_count} custom LAN mappings (Pi-hole custom.list)")
    print(f"  * Last Gravity Sync : {last_up}")
    print(f"  * Upstream DNS      : {upstreams}")
    print(_color("=" * 76, "1;34"))

    guide = status.get("guide", {})
    box_ip = guide.get("box_ip")
    if box_ip:
        print(f"  {_color('💡 Network Router Setup:', '1;33')} Set Primary DNS to {_color(box_ip, '1;32')} in router DHCP settings.")

    return 0


def cmd_enable(args: argparse.Namespace) -> int:
    res = enable_adblock()
    if args.json:
        print(json.dumps(res, indent=2))
        return 0
    print(_color("✅ DNS Ad-Blocker ENABLED. Sinkhole active on port 53.", "1;32"))
    return 0


def cmd_disable(args: argparse.Namespace) -> int:
    dur = args.duration or 0
    res = disable_adblock_temporarily(dur)
    if args.json:
        print(json.dumps(res, indent=2))
        return 0
    if dur > 0:
        print(_color(f"⚠️ DNS Ad-Blocker PAUSED for {dur} seconds. Blocking will automatically resume afterwards.", "1;33"))
    else:
        print(_color("⚠️ DNS Ad-Blocker DISABLED. Queries will pass through unfiltered.", "1;31"))
    return 0


def cmd_update(args: argparse.Namespace) -> int:
    print(_color("Updating Adblock Gravity (fetching external blocklists)...", "1;36"))
    res = execute_gravity_update()
    if args.json:
        print(json.dumps(res, indent=2))
        return 0 if res.get("status") == "ok" else 1

    print(res.get("output", ""))
    if res.get("status") == "ok":
        print(_color(f"\n✅ Gravity update complete! Active blocked domains: {res.get('total_domains', 0):,}", "1;32"))
        return 0
    else:
        print(_color("\n❌ Gravity update encountered an error.", "1;31"))
        return 1


def cmd_whitelist(args: argparse.Namespace) -> int:
    action = args.action or "list"
    domain = args.domain

    if action == "add":
        if not domain:
            print(_color("Error: domain required for 'add'", "1;31"), file=sys.stderr)
            return 1
        ok = add_whitelist_entry(domain)
        if args.json:
            print(json.dumps({"status": "ok" if ok else "error", "domain": domain}))
            return 0 if ok else 1
        print(_color(f"✅ Added '{domain}' to whitelist.", "1;32") if ok else _color("Invalid domain format.", "1;31"))
        return 0 if ok else 1

    elif action == "remove":
        if not domain:
            print(_color("Error: domain required for 'remove'", "1;31"), file=sys.stderr)
            return 1
        ok = remove_whitelist_entry(domain)
        if args.json:
            print(json.dumps({"status": "ok" if ok else "not_found", "domain": domain}))
            return 0 if ok else 1
        print(_color(f"✅ Removed '{domain}' from whitelist.", "1;32") if ok else _color(f"Domain '{domain}' was not in whitelist.", "1;33"))
        return 0 if ok else 1

    else:
        entries = get_whitelist_entries()
        if args.json:
            print(json.dumps(entries, indent=2))
            return 0
        print(_color(f"Whitelisted Domains ({len(entries)}):", "1;37"))
        if not entries:
            print("  (No whitelisted domains)")
        for d in entries:
            print(f"  * {_color(d, '1;32')}")
        return 0


def cmd_blacklist(args: argparse.Namespace) -> int:
    action = args.action or "list"
    domain = args.domain

    if action == "add":
        if not domain:
            print(_color("Error: domain required for 'add'", "1;31"), file=sys.stderr)
            return 1
        ok = add_blacklist_entry(domain)
        if args.json:
            print(json.dumps({"status": "ok" if ok else "error", "domain": domain}))
            return 0 if ok else 1
        print(_color(f"✅ Added '{domain}' to blacklist (blocked immediately).", "1;32") if ok else _color("Invalid domain format.", "1;31"))
        return 0 if ok else 1

    elif action == "remove":
        if not domain:
            print(_color("Error: domain required for 'remove'", "1;31"), file=sys.stderr)
            return 1
        ok = remove_blacklist_entry(domain)
        if args.json:
            print(json.dumps({"status": "ok" if ok else "not_found", "domain": domain}))
            return 0 if ok else 1
        print(_color(f"✅ Removed '{domain}' from blacklist.", "1;32") if ok else _color(f"Domain '{domain}' was not in blacklist.", "1;33"))
        return 0 if ok else 1

    else:
        entries = get_blacklist_entries()
        if args.json:
            print(json.dumps(entries, indent=2))
            return 0
        print(_color(f"Custom Blacklisted Domains ({len(entries)}):", "1;37"))
        if not entries:
            print("  (No custom blacklisted domains)")
        for d in entries:
            print(f"  * {_color(d, '1;31')}")
        return 0


def cmd_adlists(args: argparse.Namespace) -> int:
    action = args.action or "list"
    url = args.url

    if action == "add":
        if not url:
            print(_color("Error: URL required for 'add'", "1;31"), file=sys.stderr)
            return 1
        ok = add_adlist(url, name=args.name or "")
        if args.json:
            print(json.dumps({"status": "ok" if ok else "error", "url": url}))
            return 0 if ok else 1
        print(_color(f"✅ Adlist added: {url}", "1;32") if ok else _color("Invalid adlist URL format.", "1;31"))
        return 0 if ok else 1

    elif action == "remove":
        if not url:
            print(_color("Error: URL required for 'remove'", "1;31"), file=sys.stderr)
            return 1
        ok = remove_adlist(url)
        if args.json:
            print(json.dumps({"status": "ok" if ok else "not_found", "url": url}))
            return 0 if ok else 1
        print(_color(f"✅ Adlist removed: {url}", "1;32") if ok else _color("Adlist not found.", "1;33"))
        return 0 if ok else 1

    elif action == "toggle":
        if not url:
            print(_color("Error: URL required for 'toggle'", "1;31"), file=sys.stderr)
            return 1
        enabled = not args.disable
        ok = toggle_adlist(url, enabled)
        if args.json:
            print(json.dumps({"status": "ok" if ok else "not_found", "url": url, "enabled": enabled}))
            return 0 if ok else 1
        st_text = "ENABLED" if enabled else "DISABLED"
        print(_color(f"✅ Adlist {st_text}: {url}", "1;32") if ok else _color("Adlist not found.", "1;33"))
        return 0 if ok else 1

    else:
        lists = get_adlists()
        if args.json:
            print(json.dumps(lists, indent=2))
            return 0
        print(_color(f"Configured Adlists / Gravity Sources ({len(lists)}):", "1;37"))
        for item in lists:
            st = _color("[ON] ", "1;32") if item.get("enabled", True) else _color("[OFF]", "1;31")
            count = f"{item.get('count', 0):,}"
            print(f"  {st} {_color(item.get('name', 'List'), '1;36')}: {item.get('url')} ({count} domains)")
        return 0


def cmd_localdns(args: argparse.Namespace) -> int:
    action = args.action or "list"
    domain = args.domain
    ip = args.ip

    if action == "add":
        if not domain or not ip:
            print(_color("Error: domain and ip required for 'add'", "1;31"), file=sys.stderr)
            return 1
        ok = add_local_dns_record(domain, ip)
        if args.json:
            print(json.dumps({"status": "ok" if ok else "error", "domain": domain, "ip": ip}))
            return 0 if ok else 1
        print(_color(f"✅ Local DNS Record added: {domain} -> {ip}", "1;32") if ok else _color("Invalid IP or domain format.", "1;31"))
        return 0 if ok else 1

    elif action == "remove":
        if not domain:
            print(_color("Error: domain required for 'remove'", "1;31"), file=sys.stderr)
            return 1
        ok = remove_local_dns_record(domain)
        if args.json:
            print(json.dumps({"status": "ok" if ok else "not_found", "domain": domain}))
            return 0 if ok else 1
        print(_color(f"✅ Local DNS Record removed: {domain}", "1;32") if ok else _color("Record not found.", "1;33"))
        return 0 if ok else 1

    else:
        records = get_local_dns_records()
        if args.json:
            print(json.dumps(records, indent=2))
            return 0
        print(_color(f"Local DNS Records (custom.list) ({len(records)}):", "1;37"))
        if not records:
            print("  (No local DNS records configured)")
        for r in records:
            print(f"  * {_color(r['domain'], '1;36')} -> {_color(r['ip'], '1;32')}")
        return 0


def cmd_regex(args: argparse.Namespace) -> int:
    action = args.action or "list"
    pattern = args.pattern
    kind = args.kind or "black"

    if action == "add":
        if not pattern:
            print(_color("Error: pattern required for 'add'", "1;31"), file=sys.stderr)
            return 1
        ok = add_regex_filter(pattern, kind=kind, comment=args.comment or "")
        if args.json:
            print(json.dumps({"status": "ok" if ok else "error", "pattern": pattern, "kind": kind}))
            return 0 if ok else 1
        print(_color(f"✅ RegEx filter added ({kind}list): {pattern}", "1;32") if ok else _color("Invalid regular expression.", "1;31"))
        return 0 if ok else 1

    elif action == "remove":
        if not pattern:
            print(_color("Error: pattern required for 'remove'", "1;31"), file=sys.stderr)
            return 1
        ok = remove_regex_filter(pattern, kind=kind)
        if args.json:
            print(json.dumps({"status": "ok" if ok else "not_found", "pattern": pattern, "kind": kind}))
            return 0 if ok else 1
        print(_color(f"✅ RegEx filter removed: {pattern}", "1;32") if ok else _color("Filter not found.", "1;33"))
        return 0 if ok else 1

    else:
        filters = get_regex_filters()
        if args.json:
            print(json.dumps(filters, indent=2))
            return 0
        print(_color(f"RegEx Blacklist ({len(filters['blacklist'])}):", "1;31"))
        for it in filters["blacklist"]:
            print(f"  * {it['pattern']}" + (f" ({it['comment']})" if it.get('comment') else ""))
        print(_color(f"\nRegEx Whitelist ({len(filters['whitelist'])}):", "1;32"))
        for it in filters["whitelist"]:
            print(f"  * {it['pattern']}" + (f" ({it['comment']})" if it.get('comment') else ""))
        return 0


def cmd_charts(args: argparse.Namespace) -> int:
    charts = get_charts_telemetry()
    if args.json:
        print(json.dumps(charts, indent=2))
        return 0

    print(_color("=" * 76, "1;34"))
    print(_color("  Adblock 24-Hour Telemetry & Breakdown Charts", "1;32"))
    print(_color("=" * 76, "1;34"))

    qtypes = charts.get("query_types", {})
    print(f"\n{_color('[Query Types Distribution]:', '1;36')}")
    for qt, cnt in sorted(qtypes.items(), key=lambda x: -x[1]):
        if cnt > 0:
            print(f"  * {qt:<8}: {cnt:,}")

    upstreams = charts.get("upstreams", {})
    print(f"\n{_color('[Upstream Destinations Distribution]:', '1;36')}")
    for up, cnt in sorted(upstreams.items(), key=lambda x: -x[1]):
        print(f"  * {up:<16}: {cnt:,}")

    clients = charts.get("clients", [])
    print(f"\n{_color('[Top Querying Clients]:', '1;36')}")
    for c in clients:
        host = c.get("hostname", c["ip"])
        print(f"  * {c['ip']:<16} ({host:<18}): {c['total']} queries, {c['blocked']} blocked ({c['blocked_pct']}%)")

    return 0


def cmd_querylog(args: argparse.Namespace) -> int:
    limit = args.limit or 50
    engine = get_adblock_engine()
    queries = engine.get_recent_queries(limit)

    if args.json:
        print(json.dumps(queries, indent=2))
        return 0

    print(_color(f"Recent DNS Queries (Last {len(queries)}):", "1;37"))
    print("-" * 76)
    print(f"{'TIME':<10} {'CLIENT IP':<16} {'TYPE':<6} {'STATUS':<10} {'LATENCY':<8} {'DOMAIN'}")
    print("-" * 76)

    for q in queries:
        status = q.get("status", "")
        if status == "BLOCKED":
            st_col = _color(f"{status:<10}", "1;31")
        elif status == "CACHED":
            st_col = _color(f"{status:<10}", "1;36")
        else:
            st_col = _color(f"{status:<10}", "1;32")

        time_str = q.get("time_str", "")
        client = q.get("client_ip", "")
        qtype = q.get("type", "")
        lat = f"{q.get('latency_ms', 0):.1f}ms"
        dom = q.get("domain", "")
        print(f"{time_str:<10} {client:<16} {qtype:<6} {st_col} {lat:<8} {dom}")

    return 0


def cmd_stats(args: argparse.Namespace) -> int:
    engine = get_adblock_engine()
    stats = engine.get_stats()
    if args.json:
        print(json.dumps(stats, indent=2))
        return 0

    print(_color("=" * 76, "1;34"))
    print(_color("  Adblock Top Telemetry Statistics", "1;32"))
    print(_color("=" * 76, "1;34"))

    print(f"\n{_color('[1] Top Blocked Ad / Tracking Domains:', '1;31')}")
    top_b = stats.get("top_blocked_domains", [])
    if not top_b:
        print("  (No blocked queries recorded yet)")
    else:
        for item in top_b:
            c_str = f"{item['count']:>5}"
            print(f"  * {_color(c_str, '1;31')}  {item['domain']}")

    print(f"\n{_color('[2] Top Queried Domains:', '1;36')}")
    top_q = stats.get("top_queried_domains", [])
    if not top_q:
        print("  (No queries recorded yet)")
    else:
        for item in top_q:
            c_str = f"{item['count']:>5}"
            print(f"  * {_color(c_str, '1;36')}  {item['domain']}")

    print(f"\n{_color('[3] Top Querying Clients:', '1;33')}")
    top_c = stats.get("top_clients", [])
    if not top_c:
        print("  (No clients recorded yet)")
    else:
        for item in top_c:
            c_str = f"{item['total']:>5}"
            host = item.get("hostname", item["ip"])
            print(f"  * {_color(c_str, '1;33')}  {item['ip']} ({host}) - {item['blocked']} blocked")

    print(_color("\n" + "=" * 76, "1;34"))
    return 0


def cmd_guide(args: argparse.Namespace) -> int:
    guide = get_router_dhcp_guide()
    if args.json:
        print(json.dumps(guide, indent=2))
        return 0

    print(_color("=" * 76, "1;34"))
    print(_color("  NetworkMeasureBox — Router DHCP DNS Setup Guide", "1;32"))
    print(_color("=" * 76, "1;34"))

    box_ip = guide.get("box_ip") or "192.168.1.100"
    gw_ip = guide.get("router_gateway_ip", "192.168.1.1")

    print(f"\n{_color('Target DNS Server IP for this Device:', '1;33')} {_color(box_ip, '1;32')}")
    print(f"Detected Router Gateway IP       : {gw_ip}")

    print(f"\n{_color('English Setup Instructions:', '1;36')}")
    for step in guide.get("steps_en", []):
        print(f"  {step}")

    print(_color("\n" + "=" * 76, "1;34"))
    return 0


def main() -> int:
    parent_parser = argparse.ArgumentParser(add_help=False)
    parent_parser.add_argument("--json", action="store_true", help="Output in JSON format")

    parser = argparse.ArgumentParser(
        prog="nmb-adblock",
        parents=[parent_parser],
        description="NetworkMeasureBox DNS Ad-Blocker & Sinkhole Management CLI (Pi-hole Engine)",
    )
    # Pi-hole flag aliases
    parser.add_argument("-g", "--update", action="store_true", help="Update gravity blocklists (pihole -g alias)")
    parser.add_argument("-w", "--whitelist-add", metavar="DOMAIN", help="Add domain to whitelist (pihole -w alias)")
    parser.add_argument("-b", "--blacklist-add", metavar="DOMAIN", help="Add domain to blacklist (pihole -b alias)")

    subparsers = parser.add_subparsers(dest="command")

    # status
    subparsers.add_parser("status", parents=[parent_parser], help="Display adblock status and telemetry")

    # enable / disable
    subparsers.add_parser("enable", parents=[parent_parser], help="Enable DNS adblocking")
    p_dis = subparsers.add_parser("disable", parents=[parent_parser], help="Disable or pause DNS adblocking")
    p_dis.add_argument("-d", "--duration", type=int, default=0, help="Pause duration in seconds (0 = indefinite)")

    # update
    subparsers.add_parser("update", parents=[parent_parser], help="Update gravity blocklists")

    # whitelist
    p_wl = subparsers.add_parser("whitelist", parents=[parent_parser], help="Manage whitelisted domains")
    p_wl.add_argument("action", nargs="?", choices=["add", "remove", "list"], default="list")
    p_wl.add_argument("domain", nargs="?", help="Domain to add or remove")

    # blacklist
    p_bl = subparsers.add_parser("blacklist", parents=[parent_parser], help="Manage custom blacklisted domains")
    p_bl.add_argument("action", nargs="?", choices=["add", "remove", "list"], default="list")
    p_bl.add_argument("domain", nargs="?", help="Domain to add or remove")

    # adlists
    p_al = subparsers.add_parser("adlists", parents=[parent_parser], help="Manage gravity adlists / blocklist sources")
    p_al.add_argument("action", nargs="?", choices=["add", "remove", "toggle", "list"], default="list")
    p_al.add_argument("url", nargs="?", help="Blocklist source URL")
    p_al.add_argument("--name", help="Friendly name for adlist source")
    p_al.add_argument("--disable", action="store_true", help="Set disabled when toggling")

    # localdns
    p_ldns = subparsers.add_parser("localdns", parents=[parent_parser], help="Manage local LAN DNS records (Pi-hole custom.list)")
    p_ldns.add_argument("action", nargs="?", choices=["add", "remove", "list"], default="list")
    p_ldns.add_argument("domain", nargs="?", help="Domain name (e.g. box.lan)")
    p_ldns.add_argument("ip", nargs="?", help="IP address (e.g. 192.168.1.100)")

    # regex
    p_rgx = subparsers.add_parser("regex", parents=[parent_parser], help="Manage RegEx & wildcard domain filters")
    p_rgx.add_argument("action", nargs="?", choices=["add", "remove", "list"], default="list")
    p_rgx.add_argument("pattern", nargs="?", help="Regular expression pattern")
    p_rgx.add_argument("--kind", choices=["black", "white"], default="black", help="Filter type: black or white")
    p_rgx.add_argument("--comment", help="Comment or note for regex rule")

    # charts
    subparsers.add_parser("charts", parents=[parent_parser], help="Display 24h activity and distribution breakdown")

    # querylog
    p_log = subparsers.add_parser("querylog", parents=[parent_parser], help="Display recent DNS queries in real time")
    p_log.add_argument("--limit", type=int, default=50, help="Number of queries to show (default: 50)")

    # stats
    subparsers.add_parser("stats", parents=[parent_parser], help="Display top blocked domains and client statistics")

    # guide
    subparsers.add_parser("guide", parents=[parent_parser], help="Show dynamic router DHCP configuration instructions")

    args = parser.parse_args()

    # Handle Pi-hole flag aliases
    if args.update:
        return cmd_update(args)
    if args.whitelist_add:
        args.action = "add"
        args.domain = args.whitelist_add
        return cmd_whitelist(args)
    if args.blacklist_add:
        args.action = "add"
        args.domain = args.blacklist_add
        return cmd_blacklist(args)

    cmd = args.command or "status"

    if cmd == "status":
        return cmd_status(args)
    elif cmd == "enable":
        return cmd_enable(args)
    elif cmd == "disable":
        return cmd_disable(args)
    elif cmd == "update":
        return cmd_update(args)
    elif cmd == "whitelist":
        return cmd_whitelist(args)
    elif cmd == "blacklist":
        return cmd_blacklist(args)
    elif cmd == "adlists":
        return cmd_adlists(args)
    elif cmd == "localdns":
        return cmd_localdns(args)
    elif cmd == "regex":
        return cmd_regex(args)
    elif cmd == "charts":
        return cmd_charts(args)
    elif cmd == "querylog":
        return cmd_querylog(args)
    elif cmd == "stats":
        return cmd_stats(args)
    elif cmd == "guide":
        return cmd_guide(args)
    else:
        parser.print_help()
        return 1


if __name__ == "__main__":
    sys.exit(main())
