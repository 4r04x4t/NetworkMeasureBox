[Unit]
Description=NetworkMeasureBox: Embedded Web Management UI and REST API
After=nmb-db.service network.target
Wants=nmb-db.service

[Service]
Type=simple
User=root
Group=root
UMask=0002
SupplementaryGroups=nmb
Environment=PYTHONPATH=/opt/nmb MALLOC_ARENA_MAX=2 PYTHONUNBUFFERED=1
ExecStart=/opt/nmb/bin/nmb-web
Restart=always
RestartSec=5s
TimeoutStopSec=10
PrivateTmp=true
ProtectHome=read-only
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
