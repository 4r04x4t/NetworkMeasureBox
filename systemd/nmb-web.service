[Unit]
Description=NetworkMeasureBox: Embedded Web Management UI and REST API
After=nmb-db.service network.target
Wants=nmb-db.service

[Service]
Type=simple
User=nmb
Group=nmb
Environment=PYTHONPATH=/opt/nmb MALLOC_ARENA_MAX=2 PYTHONUNBUFFERED=1
ExecStart=/opt/nmb/bin/nmb-web
Restart=always
RestartSec=5s

# Security sandbox (CAP_NET_BIND_SERVICE allows unprivileged user 'nmb' to bind port 80)
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/nmb/live /var/log/nmb /run/nmb /etc/nmb

[Install]
WantedBy=multi-user.target
