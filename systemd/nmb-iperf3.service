[Unit]
Description=NetworkMeasureBox: Embedded iPerf3 Bandwidth Benchmark Server
After=network.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/iperf3 -s -p 5201
Restart=always
# iperf3 exits with 1 when systemd stops it.
SuccessExitStatus=1
RestartSec=5s
KillMode=process

[Install]
WantedBy=multi-user.target

