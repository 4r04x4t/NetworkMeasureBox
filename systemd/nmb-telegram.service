[Unit]
Description=NetworkMeasureBox: Management Telegram Bot Daemon
# Not network-online.target: in router mode NetworkManager tries DHCP on the WAN port at boot (an ONT has
# none) until netd takes the port, so NetworkManager-wait-online fails only after about 100 s and the bot
# started 2 minutes after boot (2026-11-10). The bot retries Telegram by itself with a growing pause.
After=nmb-db.service network.target
Wants=nmb-db.service

[Service]
Type=simple
User=nmb
Group=nmb
Environment=PYTHONPATH=/opt/nmb
ExecStart=/opt/nmb/bin/nmb-telegram
Restart=always
RestartSec=10s
TimeoutStopSec=5s

# Security sandbox
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# The bot saves settings (/dyndns ...), runs speed tests (Ookla keeps its licence under /var/lib/nmb/ookla),
# self-healing (/var/lib/nmb state) and syncs the editable settings copy on the boot partition.
ReadWritePaths=/var/lib/nmb /var/log/nmb /run/nmb /etc/nmb -/boot/firmware -/boot

[Install]
WantedBy=multi-user.target
