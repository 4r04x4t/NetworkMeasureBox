[Unit]
Description=NetworkMeasureBox: Automated Self-Healing & Component Correction Daemon
After=network.target nmb-db.service
Wants=nmb-db.service

[Service]
Type=oneshot
User=root
Group=root
SupplementaryGroups=nmb
Environment=PYTHONPATH=/opt/nmb
ExecStart=/opt/nmb/bin/nmb-heal fix
TimeoutSec=180
StandardOutput=journal
StandardError=journal

