# NetworkMeasureBox Production Configuration
# Place at /etc/nmb/nmb.conf

[system]
box_id = nmb-01
data_dir = /var/lib/nmb
run_dir = /run/nmb
log_dir = /var/log/nmb
# Hardware Memory Profile:
#   auto        - Automatically detects host RAM (activates 'low' if RAM <= 512MB / 768MB)
#   low         - Embedded Router Mode: 4MB SQLite cache, 16MB mmap, 4MB socket limits, gc trim
#   standard    - Standard Mode: 16MB SQLite cache, 64MB mmap (Raspberry Pi 3/4, 1-2GB RAM)
#   performance - High Throughput: 64MB SQLite cache, 256MB mmap, 64MB sockets (4GB+ RAM)
memory_profile = auto

[network]
# Operational Mode:
#   standalone - Endpoint Probe on existing LAN (leaves interfaces untouched, monitors via default route)
#   auto       - (default) A router gives an address over DHCP on the WAN port -> standalone;
#                several wired ports -> the others are bridged to it (LAN passthrough, switch-like).
#                No router and no internet for 90 s (ONT/modem, a PC, no cable) -> router mode (Mode A),
#                with PPPoE when pppoe_user/pppoe_password are saved and a PPPoE server answers,
#                until a router answers DHCP again.
#   mode_a     - Forced Active Gateway (NAT, DHCP server, diagnostic AP)
#   mode_b     - Forced Passive Inline Probe (Transparent Bridge)
mode = auto

# Primary WAN Uplink
wan_interface = eth0

# Secondary WAN Uplink (Multi-WAN / Backup / Dual Measurement)
# wan2_interface = eth2
# wan_mode = single               ; single | failover | loadbalance

# Multi-LAN Ports & Bridge
lan_interface = eth1
# Comma-separated list of physical Ethernet ports bridged to br-lan (e.g. eth1,eth2,eth3)
lan_ports = eth1
bridge_interface = br0

# LAN Passthrough & Link Aggregation (probe connected behind a router, standalone mode)
# Passthrough bridges the uplink to these ports, keeping their devices on the router's subnet.
# lan_passthrough_enabled = false
# passthrough_ports = eth1,eth2
# Aggregation joins these ports into bond0 as the uplink towards the router.
# 802.3ad needs LACP on the router/switch; balance-rr and balance-xor need a static LAG there;
# balance-tlb, balance-alb and active-backup need no switch configuration.
# lag_enabled = false
# lag_ports = eth0,eth3
# lag_mode = 802.3ad              ; 802.3ad | balance-rr | balance-xor | balance-tlb | balance-alb | active-backup
# lag_hash_policy = layer3+4      ; layer2 | layer2+3 | layer3+4
# lacp_rate = fast                ; slow | fast

# Dedicated Diagnostic / Isolated DMZ Port (optional)
# dmz_interface = eth3

# Interface target for automated speedtests (wan | wan2 | all | specific iface)
measurement_interface = wan

# Mode A: Active Gateway / LAN Subnet
gateway_ip = 192.168.100.1
gateway_netmask = 255.255.255.0
dhcp_range_start = 192.168.100.100
dhcp_range_end = 192.168.100.200
dhcp_lease_time = 12h

# Mode A: PPPoE Settings (Optional upstream auth)
pppoe_enabled = false
pppoe_user = 
pppoe_password = 
# 802.1Q VLAN Tagging (e.g., VLAN 835 for typical fiber ONTs; 0 to disable)
pppoe_vlan = 0

# Mode A: Emergency Diagnostic Wi-Fi AP (hostapd)
wifi_enabled = true
wifi_ssid = NMB-Diagnostic
wifi_psk = 
wifi_channel = 6

# Auto-Detection & Failover Tuning
check_interval_sec = 5
failover_timeout_sec = 15
detection_targets = 1.1.1.1,8.8.8.8,9.9.9.9

[probe]
# Target IPs to poll sub-second for latency and jitter
targets = 1.1.1.1,8.8.8.8,9.9.9.9,185.222.222.222
ping_interval_ms = 500
socket_buffer_kb = 256
batch_flush_sec = 10
# Continuous packet drop duration (seconds) across all targets to declare an ISP outage
outage_loss_seconds = 15.0

[traffic_gate]
# mode = percent uses 2% of capacity; mode = fixed uses threshold_kbps
threshold_kbps = 500
# Experimental: no scheduled speed test unless the network is provably idle (at most 500 kbps);
# a running test stops when other traffic appears. Needs a view of other devices' traffic.
experimental_stop = false

[speedtest]
# Scheduled Ookla Speedtest
schedule_cron = 0 * * * *
# Stop scheduled tests for the day at this much test traffic, for mobile data. 0 = no limit
daily_data_limit_mb = 0
# Maximum seconds to wait for network to become idle before delaying test
idle_wait_max_sec = 1800
# Target ports to check for net-neutrality throttling
port_throttle_ports = 80,443,8080,8443,5060,53

[isp]
name = Example Fiber Internet
account_id = CUST-104928
circuit_id = CKT-FIBER-01
contract_down_mbps = 1000.0
contract_up_mbps = 500.0

[smtp]
enabled = false
host = localhost
port = 587
tls = true
user = 
password = 
from_addr = nmb-reports@example.com
to_addrs = support@isp.com,admin@example.com

[telegram]
enabled = false
token = 
# Security: Comma-separated authorized Telegram chat IDs (daemon refuses to start if empty)
allowed_chat_ids = 
alert_loss_threshold_pct = 5.0
alert_latency_threshold_ms = 100.0

[web]
enabled = true
# Bind address (use 127.0.0.1 or LAN IP for restricted access, 0.0.0.0 with auth enabled)
host = 0.0.0.0
port = 80
auth_enabled = true
admin_password = admin
# Runs shell commands as root from the browser. Off unless explicitly enabled.
# terminal_enabled = false

[wireguard]
enabled = false
port = 51820
subnet = 10.8.0.1/24
subnet_ipv6 = fd42:42:42::1/64
dns = 1.1.1.1, 2606:4700:4700::1111
public_endpoint = 

[openvpn]
enabled = false
proto = udp
port = 1194
subnet = 10.9.0.0
subnet_ipv6 = fd42:42:43::/64
dns = 1.1.1.1, 2606:4700:4700::1111
public_endpoint = 

[ooni]
# Optional add-on: runs weekly when enabled.
enabled = false

[proxy]
enabled = false
port = 8443
auth_enabled = false
username = 
password = 
tls_enabled = false
listen_ipv6 = true
dns = 1.1.1.1, 2606:4700:4700::1111


[collector]
# Optional: send measurements to a central collector (nmb-collector) run by your ISP or a
# specialist. Off by default. url and token come from whoever runs the collector; case_id is
# your ticket or customer number, so they can find your measurements.
enabled = false
url = 
token = 
case_id = 
interval_min = 15
# With your consent: also send the full network diagnostics (interfaces, routes, DNS, NAT,
# Wi-Fi, traceroute, the list of devices on your network, events), hourly.
share_diagnostics = false
# With your consent: the collector may ask this box to run a speed test, send fresh
# diagnostics or upload now. Nothing else: no shell commands and no setting changes.
allow_remote_control = false
